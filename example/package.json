{
  "name": "react-native-note-example",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android -d",
    "ios": "expo run:ios -d",
    "build:ios": "xcodebuild ONLY_ACTIVE_ARCH=YES -workspace ios/NoteExample.xcworkspace -UseNewBuildSystem=YES -scheme NoteExample -configuration Debug -sdk iphonesimulator -derivedDataPath ios/build -quiet",
    "build:android": "cd android && ./gradlew assembleDebug -DtestBuildType=debug -Dorg.gradle.jvmargs=-Xmx4g"
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.11",
    "@hiraku-ai/react-native-emoji-picker": "^1.2.4",
    "expo": "~55.0.23",
    "expo-image-picker": "~55.0.20",
    "expo-status-bar": "~55.0.6",
    "expo-symbols": "~55.0.8",
    "react": "19.2.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "2.28.0",
    "react-native-keyboard-controller": "1.20.1",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "5.6.2",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "expo-dev-client": "~55.0.32",
    "react-native-builder-bob": "^0.41.0",
    "react-native-monorepo-config": "^0.3.3"
  },
  "private": true
}
